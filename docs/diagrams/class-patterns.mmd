classDiagram
    %% --- Enums ---
    class DiagramType {
        <<enumeration>>
        CLASS
        SEQUENCE
    }

    class RelationType {
        <<enumeration>>
        ASSOCIATION
        INHERITANCE
        REALIZATION
        DEPENDENCY
        AGGREGATION
        COMPOSITION
    }

    class ImageFormat {
        <<enumeration>>
        PNG
        JPEG
    }

    %% [10/14 수정 1] CLI 클래스 제거 (명세서 v0.2 FR-09-2 제외 항목과 일치)

    %% --- Core / Controller ---
    class Workspace {
        <<Facade>>
        -textEditor : TextEditor
        -canvas : CanvasRenderer
        -syncManager : SyncManager
        -history : VersionHistory
        +saveProject() void
        +loadProject(file: File) void
        +exportToImage(format: ImageFormat) void
        +undo() void
        +redo() void
        %% [10/14 수정 3] 마우스 입력은 모두 Workspace를 거쳐 SyncManager로 전달
        +moveNode(nodeId: String, x: double, y: double) void
        +updateEdgeRoute(edgeId: String, waypoints: List~Point~) void
        +unpinNode(nodeId: String) void
    }

    %% [10/14 수정 5] 화면 갱신용 Observer 인터페이스 신설
    class DiagramView {
        <<interface · Observer>>
        +onDiagramUpdated(diagram: AbstractDiagram, layout: LayoutResult) void
        +onParseError(errors: List~ParseError~) void
    }

    class TextEditor {
        -text : String
        +setText(text: String) void
        +highlightError(line: int, message: String) void
    }

    %% [10/14 수정 3] 그리기 전용으로 축소 (updateNodePosition, updateEdgeRoute, unpinNode 제거)
    class CanvasRenderer {
        -zoom : double
        -minFontSize : int
        +render(diagram: AbstractDiagram, layout: LayoutResult) void
        +setZoom(zoom: double) void
    }

    class SyncManager {
        <<Mediator>>
        -parser : MermaidParser
        %% [10/14 수정 4] 단일 layoutEngine 대신 팩토리로 다이어그램 종류별 엔진 선택
        -layoutEngineFactory : LayoutEngineFactory
        -currentMetadata : LayoutMetadata
        %% [10/14 수정 5] 결과를 받을 화면 목록
        -views : List~DiagramView~
        +addView(view: DiagramView) void
        +onTextChanged(text: String) void
        +onCanvasNodeMoved(nodeId: String, x: double, y: double) void
        %% [10/14 수정 3] 간선 수정·고정 해제 처리를 SyncManager로 일원화
        +onEdgeRouteChanged(edgeId: String, waypoints: List~Point~) void
        +onUnpin(nodeId: String) void
        -mergeMetadata(oldMeta: LayoutMetadata, newDiagram: AbstractDiagram) LayoutMetadata
        -notifyViews(diagram: AbstractDiagram, layout: LayoutResult) void
    }

    %% --- Services ---
    class VersionHistory {
        <<Caretaker>>
        -history : List~Snapshot~
        +push(snapshot: Snapshot) void
        +undo() Snapshot
        +redo() Snapshot
        %% [10/14 보완] 특정 버전 복원·목록
        +restore(id: String) Snapshot
        +list() List~Snapshot~
    }

    class Snapshot {
        <<Memento>>
        %% [10/14 보완] 버전 식별자
        -id : String
        -textState : String
        -metadataState : String
        -timestamp : DateTime
    }

    class FileManager {
        +save(code: String, metadata: String) File
        +load(file: File) DiagramData
    }

    class ImageExporter {
        +export(canvas: CanvasRenderer, format: ImageFormat) File
    }

    %% --- Data / Helper Types ---
    class DiagramData {
        +code : String
        +metadata : String
    }

    class Point {
        +x : double
        +y : double
    }

    class NodePosition {
        +x : double
        +y : double
        +width : double
        +height : double
        +isPinned : boolean
    }

    class EdgeRoute {
        +waypoints : List~Point~
        %% [10/14 수정 2] 사용자가 손으로 고친 경로인지 표시
        +isManual : boolean
    }

    %% [10/14 보완] SyntaxError → ParseError (JavaScript 내장 클래스명과 충돌 방지)
    class ParseError {
        +line : int
        +column : int
        +message : String
    }

    class ParseResult {
        +diagram : AbstractDiagram
        +errors : List~ParseError~
        +isSuccess() boolean
    }

    class LayoutMetadata {
        -positions : Map~String, NodePosition~
        %% [10/14 수정 2] 수동 간선 경로 저장
        -edgeRoutes : Map~String, EdgeRoute~
        +getPosition(nodeId: String) NodePosition
        +setPosition(nodeId: String, pos: NodePosition) void
        +setPinned(nodeId: String, pinned: boolean) void
        +getEdgeRoute(edgeId: String) EdgeRoute
        +setEdgeRoute(edgeId: String, route: EdgeRoute) void
    }

    %% --- Engines (Parsing & Layout) ---
    class MermaidParser {
        +parse(text: String) ParseResult
    }

    %% [10/14 수정 4] 다이어그램 종류에 맞는 레이아웃 엔진 생성
    class LayoutEngineFactory {
        <<Factory>>
        +forType(type: DiagramType) LayoutEngine
    }

    class LayoutEngine {
        <<interface · Strategy>>
        +applyLayout(diagram: AbstractDiagram, metadata: LayoutMetadata) LayoutResult
    }

    class LayeredLayoutEngine {
        +applyLayout(diagram: AbstractDiagram, metadata: LayoutMetadata) LayoutResult
    }

    class SequenceLayoutEngine {
        +applyLayout(diagram: AbstractDiagram, metadata: LayoutMetadata) LayoutResult
    }

    class LayoutResult {
        +nodePositions : Map~String, NodePosition~
        +edgeRoutes : Map~String, EdgeRoute~
    }

    %% --- Data Models ---
    class AbstractDiagram {
        <<abstract>>
        -type : DiagramType
        -nodes : List~AbstractNode~
        -edges : List~AbstractEdge~
        +getNode(id: String) AbstractNode
    }

    class AbstractNode {
        <<abstract>>
        -id : String
        -label : String
    }

    class AbstractEdge {
        <<abstract>>
        -id : String
        -sourceId : String
        -targetId : String
        -label : String
    }

    class ClassNode {
        -attributes : List~String~
        -methods : List~String~
    }

    class ParticipantNode {
        -order : int
    }

    class RelationEdge {
        -relationType : RelationType
        -multiplicity : String
    }

    class MessageEdge {
        %% [10/14 보완] 시퀀스 메시지 순서
        -order : int
        -isReply : boolean
    }

    %% --- Relationships ---

    %% Core Controller Compositions
    Workspace "1" *-- "1" TextEditor
    Workspace "1" *-- "1" CanvasRenderer
    Workspace "1" *-- "1" SyncManager
    Workspace "1" *-- "1" VersionHistory

    %% [10/14 수정 3] 화면 입력은 Workspace로 전달
    TextEditor "1" ..> "1" Workspace : 코드 변경 전달
    CanvasRenderer "1" ..> "1" Workspace : 마우스 입력 전달

    %% [10/14 수정 5] Observer: 화면이 DiagramView를 구현하고 SyncManager가 알림
    DiagramView <|.. CanvasRenderer : Realization
    DiagramView <|.. TextEditor : Realization
    SyncManager "1" o-- "*" DiagramView : notifies

    %% Service Dependencies
    Workspace "1" ..> "1" FileManager : uses
    Workspace "1" ..> "1" ImageExporter : uses
    VersionHistory "1" o-- "*" Snapshot : aggregates
    FileManager "1" ..> "1" DiagramData : produces
    ImageExporter "1" ..> "1" ImageFormat : uses

    %% SyncManager Dependencies
    SyncManager "1" ..> "1" MermaidParser : uses
    SyncManager "1" ..> "1" LayoutEngineFactory : uses
    SyncManager "1" ..> "1" AbstractDiagram : updates
    SyncManager "1" *-- "1" LayoutMetadata : manages

    %% Engine Implementations & Dependencies
    LayoutEngineFactory "1" ..> "*" LayoutEngine : creates
    LayoutEngine <|.. LayeredLayoutEngine : Realization
    LayoutEngine <|.. SequenceLayoutEngine : Realization
    LayoutEngine "1" ..> "1" LayoutResult : produces

    MermaidParser "1" ..> "1" ParseResult : produces
    ParseResult "1" *-- "*" ParseError : contains
    ParseResult "1" o-- "0..1" AbstractDiagram : contains

    %% Metadata & Layout Result Dependencies
    LayoutMetadata "1" *-- "*" NodePosition : contains
    LayoutMetadata "1" *-- "*" EdgeRoute : contains
    LayoutResult "1" *-- "*" NodePosition : contains
    LayoutResult "1" *-- "*" EdgeRoute : contains
    EdgeRoute "1" *-- "*" Point : contains

    %% Model Inheritances & Compositions
    AbstractDiagram "1" *-- "*" AbstractNode : contains
    AbstractDiagram "1" *-- "*" AbstractEdge : contains
    AbstractDiagram "1" --> "1" DiagramType
    RelationEdge "1" --> "1" RelationType

    AbstractNode <|-- ClassNode
    AbstractNode <|-- ParticipantNode

    AbstractEdge <|-- RelationEdge
    AbstractEdge <|-- MessageEdge
